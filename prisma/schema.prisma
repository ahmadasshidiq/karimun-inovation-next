generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("status")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsType {
  BERITA
  AGENDA
}

enum NewsCategory {
  SOSIALISASI
  BIMBINGAN_TEKNIS
  DISEMINASI
}

model Role {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  permission Json
  users      User[]

  @@map("roles")
}

model User {
  id                    String                          @id @default(uuid()) @db.Uuid
  roleId                String                          @map("role_id") @db.Uuid
  institutionId         String                          @map("institution_id") @db.Uuid
  username              String                          @unique @db.VarChar(100)
  email                 String?                         @unique @db.VarChar(255)
  fullname              String                          @db.VarChar(255)
  nip                   String?                         @unique @db.VarChar(50)
  phone                 String?                         @db.VarChar(30)
  status                Status                          @default(ACTIVE)
  currentToken          String?                         @map("current_token") @db.Text
  password              String                          @db.Text
  salt                  String                          @db.VarChar(255)
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?                       @map("deleted_at") @db.Timestamptz(3)
  role                  Role                            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institution           Institution                     @relation(fields: [institutionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  innovations           Innovation[]
  approvedInnovations   Innovation[]                    @relation("InnovationApprovals")
  innovationSubmissions InnovationSubmission[]
  reviewedSubmissions   InnovationSubmission[]          @relation("SubmissionReviews")
  reviewedIndicators    InnovationIndicatorAssessment[] @relation("IndicatorReviews")
  newsArticles          News[]

  @@index([roleId])
  @@index([institutionId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Institution {
  id                  String        @id @default(uuid()) @db.Uuid
  nomenclatureId      String        @map("nomenklatur_id") @db.Uuid
  name                String        @db.VarChar(255)
  type                String        @db.VarChar(100)
  status              Status        @default(ACTIVE)
  parentInstitutionId String?       @map("parent_institution_id") @db.Uuid
  address             String?       @db.Text
  latitude            Decimal?      @db.Decimal(10, 8)
  longitude           Decimal?      @db.Decimal(11, 8)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(3)
  nomenclature        Nomenclature  @relation(fields: [nomenclatureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentInstitution   Institution?  @relation("InstitutionHierarchy", fields: [parentInstitutionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childInstitutions   Institution[] @relation("InstitutionHierarchy")
  users               User[]

  @@index([nomenclatureId])
  @@index([parentInstitutionId])
  @@index([status])
  @@index([deletedAt])
  @@map("institutions")
}

model Nomenclature {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  description  String?       @db.Text
  status       Status        @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  institutions Institution[]

  @@index([status])
  @@map("nomenklatur")
}

model Innovation {
  id                   String                          @id @default(uuid()) @db.Uuid
  name                 String                          @db.VarChar(255)
  latitude             Decimal?                        @db.Decimal(10, 8)
  longitude            Decimal?                        @db.Decimal(11, 8)
  status               Status                          @default(ACTIVE)
  submissionStatus     String                          @default("INCOMPLETE") @map("submission_status") @db.VarChar(20)
  approvalStatus       String                          @default("PENDING_REVIEW") @map("approval_status") @db.VarChar(30)
  approvalNote         String?                         @map("approval_note") @db.Text
  approvedById         String?                         @map("approved_by") @db.Uuid
  approvedAt           DateTime?                       @map("approved_at") @db.Timestamptz(3)
  initiatorType        String?                         @map("initiator_type") @db.VarChar(100)
  initiatorName        String?                         @map("initiator_name") @db.VarChar(255)
  stage                String?                         @map("stage") @db.VarChar(255)
  type                 String?                         @db.VarChar(100)
  classification       String?                         @db.VarChar(100)
  category             String?                         @db.VarChar(100)
  innovationForm       String?                         @map("innovation_form") @db.VarChar(100)
  thematic             String?                         @map("thematic") @db.VarChar(255)
  pkpnCluster          String?                         @map("pkpn_cluster") @db.VarChar(255)
  pkpnSubCluster       String?                         @map("pkpn_sub_cluster") @db.VarChar(255)
  governmentAffairs    String?                         @map("government_affairs") @db.VarChar(255)
  psn                  String?                         @map("psn") @db.VarChar(255)
  trialPeriod          DateTime?                       @map("trial_period") @db.Date
  implementationPeriod DateTime?                       @map("implementation_period") @db.Date
  isDevelopment        Boolean                         @default(false) @map("is_development")
  description          String?                         @db.Text
  purpose              String?                         @db.Text
  files                Json                            @default("[]")
  createdById          String                          @map("created_by") @db.Uuid
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                       @map("deleted_at") @db.Timestamptz(3)
  createdBy            User                            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy           User?                           @relation("InnovationApprovals", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  indicatorAssessments InnovationIndicatorAssessment[]
  submissions          InnovationSubmission[]

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([classification])
  @@index([deletedAt])
  @@index([approvalStatus])
  @@map("innovations")
}

model InnovationIndicatorAssessment {
  id           String                        @id @default(uuid()) @db.Uuid
  innovationId String                        @map("innovation_id") @db.Uuid
  indicatorId  Int                           @map("indicator_id")
  parameter    String                        @db.Text
  score        Decimal                       @db.Decimal(8, 2)
  reviewStatus String                        @default("PENDING") @map("review_status") @db.VarChar(20)
  reviewNote   String?                       @map("review_note") @db.Text
  reviewedById String?                       @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?                     @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  innovation   Innovation                    @relation(fields: [innovationId], references: [id], onDelete: Cascade)
  reviewedBy   User?                         @relation("IndicatorReviews", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  documents    InnovationIndicatorDocument[]

  @@unique([innovationId, indicatorId])
  @@index([innovationId])
  @@map("innovation_indicator_assessments")
}

model InnovationIndicatorDocument {
  id             String                        @id @default(uuid()) @db.Uuid
  assessmentId   String                        @map("assessment_id") @db.Uuid
  documentNumber String?                       @map("document_number") @db.VarChar(255)
  documentDate   DateTime?                     @map("document_date") @db.Date
  documentTitle  String                        @map("document_title") @db.VarChar(255)
  originalName   String                        @map("original_name") @db.VarChar(255)
  objectName     String                        @map("object_name") @db.Text
  url            String                        @db.Text
  mimeType       String                        @map("mime_type") @db.VarChar(100)
  size           Int
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  assessment     InnovationIndicatorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("innovation_indicator_documents")
}

model Announcement {
  id               String    @id @default(uuid()) @db.Uuid
  title            String    @db.VarChar(255)
  content          String    @default("") @db.Text
  announcementDate DateTime  @map("announcement_date") @db.Date
  status           Status    @default(ACTIVE)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status])
  @@index([announcementDate])
  @@index([deletedAt])
  @@map("announcements")
}

model News {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(255)
  excerpt     String       @db.Text
  content     String       @db.Text
  coverImage  String?      @map("cover_image") @db.Text
  category    NewsCategory
  categoryId  String?      @map("category_id") @db.Uuid
  type        NewsType     @default(BERITA)
  eventDate   DateTime?    @map("event_date") @db.Date
  isFeatured  Boolean      @default(false) @map("is_featured")
  status      NewsStatus   @default(DRAFT)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)
  authorId    String       @map("author_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryRef NewsCategoryEntity? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, publishedAt])
  @@index([isFeatured, publishedAt])
  @@index([authorId])
  @@index([deletedAt])
  @@index([categoryId])
  @@map("news")
}

model NewsCategoryEntity {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  news      News[]

  @@index([isActive])
  @@map("news_categories")
}

model InnovationIndex {
  id        String   @id @default(uuid()) @db.Uuid
  year      Int      @unique
  score     Decimal  @db.Decimal(6, 2)
  predicate String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("innovation_indices")
}

model DashboardConfiguration {
  id              String   @id @default(uuid()) @db.Uuid
  countdownTarget DateTime @map("countdown_target") @db.Timestamptz(3)
  countdownActive Boolean  @default(true) @map("countdown_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("dashboard_configurations")
}

model CompetitionPeriod {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @db.VarChar(255)
  startDate   DateTime               @map("start_date") @db.Date
  endDate     DateTime               @map("end_date") @db.Date
  description String?                @db.Text
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(3)
  submissions InnovationSubmission[]

  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("competition_periods")
}

model InnovationSubmission {
  id            String             @id @default(uuid()) @db.Uuid
  innovationId  String             @map("innovation_id") @db.Uuid
  track         String             @db.VarChar(30)
  periodId      String?            @map("period_id") @db.Uuid
  status        String             @default("SUBMITTED") @db.VarChar(30)
  submittedById String             @map("submitted_by") @db.Uuid
  submittedAt   DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  reviewNote    String?            @map("review_note") @db.Text
  reviewedById  String?            @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  innovation    Innovation         @relation(fields: [innovationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  period        CompetitionPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy   User               @relation(fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy    User?              @relation("SubmissionReviews", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([innovationId])
  @@index([track, status])
  @@index([periodId])
  @@map("innovation_submissions")
}
