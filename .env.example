# Base URL API publik yang diakses oleh landing page.
NEXT_PUBLIC_PUBLIC_API_URL=https://iga.jaxergrup.com

# Origin browser yang diizinkan mengakses endpoint publik lintas domain.
PUBLIC_API_ALLOWED_ORIGINS=https://iga.jaxergrup.com

# Penyimpanan cover berita dan dokumen dashboard (MinIO / S3-compatible).
# Isi dengan kredensial server, jangan commit nilai aslinya ke Git.
MINIO_ENDPOINT=s3.jahris.id
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=jaxer
MINIO_SECRET_KEY=Admin11234
MINIO_BUCKET_AVATARS=iga-project
MINIO_PUBLIC_URL=https://s3.jahris.id
